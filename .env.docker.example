# AVISO: utilize sempre aspas únicas caso utilize este .env em CI/CD
# Este modelo de .env será utilizado pelos serviços do compose.yaml 
# .env.docker: app-dev para executar a api em produção
# .env.docker.dev: app-dev para executar a api em desenvolvimento
# .env.docker.test: app-dev para executar a api em fase de testes

LOG_LEVEL=info
NODE_ENV=development
APP_PORT=3333
APP_HOST=127.0.0.1
APP_DIR= # absolute path to the project root
APP_URL= # deploy or dev url where the service will run
APP_SUPER_USER_NAME=
APP_SUPER_USER_EMAIL=
APP_SUPER_USER_PASSWORD=

FRONTEND_POLICY_URL=
FRONTEND_TERMS_URL=

DB_HOST= # database service name
DB_PORT=
DB_USER=
DB_PASS=
DB_NAME=
DB_TIMEZONE=UTC # for me, -03:00
DB_LOGGING= # same as false
DB_SYNCHRONIZE= # same as false

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_ORIGIN= # an email address

STRIPE_KEY=
STRIPE_ENDPOINT_SECRET=

JWT_TOKEN_SECRET=
BCRYPT_SALT_ROUNDS=10


VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

REDIS_HOST= # redis service name from compose.yaml
REDIS_PORT=6379
REDIS_PASSWORD=

BULLBOARD_USER_LOGIN=
BULLBOARD_USER_PASSWORD=

TESTING_DEFAULT_USER_PASSWORD="secret"
TESTING_DEFAULT_OTP_CODE="000000"