{
	"name": "typeorm-api",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"dev": "ts-node-dev -r tsconfig-paths/register ./src/server.ts --env=development",
		"build": "tsc --project tsconfig.json && tscpaths -p tsconfig.json -s ./src -o ./dist",
		"start": "node ./dist/server.js --env=production",
		"seed": "ts-node -r tsconfig-paths/register ./node_modules/typeorm-extension/bin/cli.cjs seed:run -d ./src/data-source.ts",
		"typeorm:generate": "npx ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts",
		"typeorm:migrate": "npx ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
		"typeorm:revert": "npx ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
		"typeorm:drop": "npx ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js schema:drop -d src/database/data-source.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@faker-js/faker": "^8.4.0",
		"bcrypt": "^5.1.1",
		"body-parser": "^1.20.2",
		"cors": "^2.8.5",
		"dotenv": "^16.4.1",
		"dotenv-expand": "^10.0.0",
		"express": "^4.18.2",
		"express-async-errors": "^3.1.1",
		"express-handlebars": "^8.0.2",
		"fs-jetpack": "^5.1.0",
		"jsonwebtoken": "^9.0.2",
		"multer": "^2.0.2",
		"nodemailer": "^7.0.5",
		"pg": "^8.16.3",
		"reflect-metadata": "^0.2.1",
		"typeorm": "^0.3.20",
		"typeorm-extension": "^3.4.0",
		"uuid": "^11.1.0",
		"zod": "^4.0.15"
	},
	"devDependencies": {
		"@types/bcrypt": "^5.0.2",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/jsonwebtoken": "^9.0.5",
		"@types/multer": "^2.0.0",
		"@types/nodemailer": "^7.0.1",
		"ts-node-dev": "^2.0.0",
		"tsconfig-paths": "^4.2.0",
		"tscpaths": "^0.0.9",
		"typescript": "^5.3.3"
	}
}