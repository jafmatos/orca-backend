{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:e2e:watch": "jest --config ./test/jest-e2e.json --runInBand --watchAll",
    "test:e2e:debug": "node --inspect-brk=0.0.0.0:9229 -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --config ./test/jest-e2e.json --runInBand",
    "typeorm:dev": "typeorm-ts-node-commonjs -d ./src/database/data-source.ts",
    "typeorm:prod": "typeorm -d ./dist/database/data-source.js",
    "migration:dev:generate": "DB_HOST=localhost DOTENV_PATH=.devcontainer/.env npm run typeorm:dev -- migration:generate",
    "migration:dev:run": "DB_HOST=localhost DOTENV_PATH=.devcontainer/.env npm run typeorm:dev -- migration:run",
    "migration:dev:revert": "DB_HOST=localhost DOTENV_PATH=.devcontainer/.env npm run typeorm:dev -- migration:revert",
    "migration:dev:show": "DB_HOST=localhost DOTENV_PATH=.devcontainer/.env npm run typeorm:dev -- migration:show",
    "migration:prod:run": "npm run typeorm:prod -- migration:run",
    "migration:prod:revert": "npm run typeorm:prod -- migration:revert",
    "migration:prod:show": "npm run typeorm:prod -- migration:show",
		"docker:dev": "docker compose --project-name backend_devcontainer -f ./.devcontainer/compose.yaml --env-file ./.devcontainer/.env",
    "docker:dev:up": "npm run docker:dev -- up --build -d && docker compose --project-name backend_devcontainer exec -d app-dev npm run start:dev",
    "docker:dev:down": "npm run docker:dev -- down",
    "docker:dev:stop": "npm run docker:dev -- stop",
    "docker:dev:restart": "npm run docker:dev -- restart",
    "docker:dev:logs": "npm run docker:dev -- logs -f",
    "devcontainer:up": "npm run docker:dev -- up --build -d",
    "devcontainer:down": "npm run docker:dev:down",
    "devcontainer:stop": "npm run docker:dev:stop",
    "devcontainer:restart": "npm run docker:dev:restart",
    "devcontainer:logs": "npm run docker:dev:logs",
		"docker:test": "docker compose --profile test -f compose.yaml --env-file .env.docker.testing",
    "docker:test:up": "npm run docker:test -- up --build --abort-on-container-exit",
    "docker:test:down": "npm run docker:test -- down",
    "docker:test:stop": "npm run docker:test -- stop",
    "docker:test:restart": "npm run docker:test -- restart",
    "docker:test:logs": "npm run docker:test -- logs -f",
    "docker:test:watch": "npm run docker:test -- run --rm -v .:/usr/src/app -v /usr/src/app/node_modules app-test npm run test:e2e:watch",
    "docker:test:debug": "npm run docker:test -- run --rm -p 9229:9229 -v .:/usr/src/app -v /usr/src/app/node_modules app-test npm run test:e2e:debug",
		"docker:prod": "docker compose --profile production -f compose.yaml --env-file .env.docker.production",
    "docker:prod:up": "npm run docker:prod -- up --build -d",
    "docker:prod:down": "npm run docker:prod -- down",
    "docker:prod:stop": "npm run docker:prod -- stop",
    "docker:prod:restart": "npm run docker:prod -- restart",
    "docker:prod:logs": "npm run docker:prod -- logs -f"
  },
  "dependencies": {
    "@bull-board/api": "^8.1.2",
    "@bull-board/express": "^8.1.2",
    "@bull-board/nestjs": "^8.1.2",
    "@bull-board/ui": "^8.1.2",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@scalar/nestjs-api-reference": "^1.2.9",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "csv-stringify": "^6.8.1",
    "dotenv": "^17.4.2",
    "expo-server-sdk": "^6.1.0",
    "express-basic-auth": "^1.2.1",
    "fs-jetpack": "^5.1.0",
    "glob": "^13.0.6",
    "helmet": "^8.2.0",
    "nestjs-zod": "^5.4.0",
    "nodemailer": "^9.0.3",
    "openai": "^6.45.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "stripe": "^22.3.0",
    "typeorm": "^1.0.0",
    "uuid": "^14.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@faker-js/faker": "^8.4.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/bull": "^3.15.9",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.0.0",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
