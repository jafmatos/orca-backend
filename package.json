{
	"name": "orca-backend",
	"version": "1.0.0",
	"description": "",
	"scripts": {
		"test": "jest",
		"build": "tsc --project tsconfig.json && tscpaths -p tsconfig.json -s ./src -o ./dist",
		"start:dev": "ts-node-dev --respawn -r tsconfig-paths/register ./src/server.ts --env=development",
		"start:test": "ts-node-dev --respawn -r tsconfig-paths/register ./src/server.ts --env=testing",
		"start:prod": "node ./dist/server.js --env=production",
		"docker:prod:up": "docker compose --profile prod --env-file .env.docker up -d --build",
		"docker:prod:stop": "docker compose --profile prod --env-file .env.docker stop",
		"docker:prod:start": "docker compose --profile prod --env-file .env.docker start",
		"docker:prod:restart": "docker compose --profile prod --env-file .env.docker restart",
		"docker:prod:logs": "docker compose --profile prod --env-file .env.docker logs -f",
		"docker:dev:up": "docker compose --profile dev --env-file .env.docker.dev up --build",
		"docker:dev:stop": "docker compose --profile dev --env-file .env.docker.dev stop",
		"docker:dev:start": "docker compose --profile dev --env-file .env.docker.dev start",
		"docker:dev:restart": "docker compose --profile dev --env-file .env.docker.dev restart",
		"docker:dev:logs": "docker compose --profile dev --env-file .env.docker.dev logs -f",
		"docker:test": "docker compose --profile jest --env-file .env.docker.test up --build --abort-on-container-exit",
		"docker:test:up": "docker compose --profile test --env-file .env.docker.test up -d --build",
		"docker:test:restart": "docker compose --profile test --env-file .env.docker.test restart",
		"docker:test:stop": "docker compose --profile test --env-file .env.docker.test stop",
		"docker:test:logs": "docker compose --profile test --env-file .env.docker.test logs -f",
		"docker:backup": "docker exec -it backup backup",
		"docker:restore": "./restore.sh",
		"typeorm:seed": "ts-node -r tsconfig-paths/register ./node_modules/typeorm-extension/bin/cli.cjs seed:run -d ./src/data-source.ts",
		"typeorm:generate": "npx ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts",
		"typeorm:migrate": "npx ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
		"typeorm:revert": "npx ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
		"typeorm:drop": "npx ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js schema:drop -d src/database/data-source.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@bull-board/api": "^6.13.1",
		"@bull-board/express": "^6.13.1",
		"@bull-board/ui": "^6.13.1",
		"@faker-js/faker": "^8.4.1",
		"@jest/globals": "^30.2.0",
		"@types/bull": "^3.15.9",
		"bcrypt": "^5.1.1",
		"body-parser": "^1.20.2",
		"bull": "^4.16.5",
		"cors": "^2.8.5",
		"dotenv": "^16.4.1",
		"dotenv-expand": "^10.0.0",
		"ejs": "^3.1.10",
		"express": "^4.18.2",
		"express-async-errors": "^3.1.1",
		"express-ejs-layouts": "^2.5.1",
		"express-handlebars": "^8.0.2",
		"fs-jetpack": "^5.1.0",
		"jest": "^30.2.0",
		"jsonwebtoken": "^9.0.2",
		"multer": "^2.0.2",
		"nodemailer": "^7.0.5",
		"pg": "^8.16.3",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"redis": "^4.7.1",
		"reflect-metadata": "^0.2.1",
		"stripe": "^18.5.0",
		"supertest": "^7.1.4",
		"ts-jest": "^29.4.5",
		"typeorm": "^0.3.20",
		"typeorm-extension": "^3.4.0",
		"uuid": "^11.1.0",
		"web-push": "^3.6.7",
		"zod": "^4.0.15"
	},
	"devDependencies": {
		"@babel/cli": "^7.28.3",
		"@babel/core": "^7.28.5",
		"@babel/preset-env": "^7.28.5",
		"@babel/preset-typescript": "^7.28.5",
		"@types/bcrypt": "^5.0.2",
		"@types/cors": "^2.8.17",
		"@types/ejs": "^3.1.5",
		"@types/express": "^4.17.21",
		"@types/express-ejs-layouts": "^2.5.4",
		"@types/jsonwebtoken": "^9.0.5",
		"@types/multer": "^2.0.0",
		"@types/nodemailer": "^7.0.1",
		"@types/pg": "^8.15.6",
		"@types/react": "^19.1.14",
		"@types/react-dom": "^19.1.9",
		"@types/supertest": "^6.0.3",
		"@types/web-push": "^3.6.4",
		"babel-jest": "^30.2.0",
		"ts-node-dev": "^2.0.0",
		"tsconfig-paths": "^4.2.0",
		"tscpaths": "^0.0.9",
		"typescript": "^5.9.3"
	}
}