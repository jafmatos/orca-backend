{
	"compilerOptions": {
		"jsx": "react-jsx",
		"target": "es2020",
		"lib": [
			"ES5",
			"ES6",
			"DOM"
		],
		"module": "commonjs",
		"rootDir": "./src",
		"moduleResolution": "node",
		"baseUrl": "./src",
		"paths": {
			"Tests/*": [
				"./*"
			]
		},
		"typeRoots": [
			"@types",
			"./node_modules/@types"
		],
		"sourceMap": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"outDir": "./dist",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"resolveJsonModule": true,
		"skipLibCheck": true
	},
	"exclude": ["../src"]
}